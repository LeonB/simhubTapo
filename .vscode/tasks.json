{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build (Debug)",
            "type": "shell",
            "command": "& 'C:/Program Files/Microsoft Visual Studio/2022/Community/MSBuild/Current/Bin/MSBuild.exe' '${workspaceFolder}/TapoPlugin.sln' /p:Configuration=Debug /v:minimal",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "options": {
                "env": {
                    "SIMHUB_INSTALL_PATH": "C:/Program Files (x86)/SimHub/"
                }
            },
            "problemMatcher": {
                "owner": "msbuild",
                "fileLocation": "absolute",
                "pattern": {
                    "regexp": "^(.*)\\((\\d+),(\\d+)\\):\\s+(error|warning)\\s+(\\w+):\\s+(.*)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "severity": 4,
                    "code": 5,
                    "message": 6
                }
            }
        },
        {
            "label": "Build (Release)",
            "type": "shell",
            "command": "& 'C:/Program Files/Microsoft Visual Studio/2022/Community/MSBuild/Current/Bin/MSBuild.exe' '${workspaceFolder}/TapoPlugin.sln' /p:Configuration=Release /v:minimal",
            "group": "build",
            "options": {
                "env": {
                    "SIMHUB_INSTALL_PATH": "C:/Program Files (x86)/SimHub/"
                }
            },
            "problemMatcher": {
                "owner": "msbuild",
                "fileLocation": "absolute",
                "pattern": {
                    "regexp": "^(.*)\\((\\d+),(\\d+)\\):\\s+(error|warning)\\s+(\\w+):\\s+(.*)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "severity": 4,
                    "code": 5,
                    "message": 6
                }
            }
        }
    ]
}
